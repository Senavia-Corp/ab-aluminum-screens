---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, localizedHref, loc, type Lang } from '../../lib/i18n';
import { SERVICES } from '../../lib/nav';
import { getServiceArea, getServiceAreas, getLocalServiceRoutesForCity } from '../../lib/queries';
import { COUNTY_BY_SLUG, WIND_BY_COUNTY } from '../../lib/areas';
import { BUSINESS_ID, SITE_ORIGIN } from '../../lib/seo';
import { DEFAULT_PRICING, estimateBreakdown, formatUSD } from '../../lib/pricing';
import Breadcrumbs from '../Breadcrumbs.astro';
import PageHero from '../PageHero.astro';
import AnswerBlock from '../AnswerBlock.astro';
import AboutIntro from '../AboutIntro.astro';
import GalleryMosaic from '../GalleryMosaic.astro';
import ProcessSteps from '../ProcessSteps.astro';
import FinancingTeaser from '../FinancingTeaser.astro';
import Reviews from '../Reviews.astro';
import FAQ from '../FAQ.astro';
import LeadSection from '../LeadSection.astro';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const area = await getServiceArea(slug);
// Services that have a dedicated landing page for THIS city → deep-link the cards to them.
const localRoutes = new Set<string>(await getLocalServiceRoutesForCity(slug));
const t = useT(lang);

const cityName = loc<string>(area, 'title', lang) || area?.title || slug;
const titlePage = loc<string>(area, 'titlePage', lang) || area?.titlePage || `Contractors in ${cityName}`;
const heading = loc<string>(area, 'heading', lang) || area?.heading;
const p1 = loc<string>(area, 'paragraph1', lang) || area?.paragraph1;
const p2 = loc<string>(area, 'paragraph2', lang) || area?.paragraph2;
const services = loc<any[]>(area, 'services', lang) || area?.services || [];
// The CMS stores services[] as [pergola, pool, louvered, screens]; SERVICES (nav.ts) is ordered
// [pergola, pool, screens, louvered]. Crossing them by loop index swapped cards 3 and 4 on all 94
// pages — "Patio Screens" described louvered roofs and vice versa. Verified same order on all 47
// docs, and servicesEs mirrors it, so one constant covers both languages.
// ponytail: fix the mapping, not the data — reordering 47 CMS documents to match nav.ts would be
// the same bug pointed the other way. A doc that ever deviates falls back to the static blurb.
const CMS_SERVICE_ORDER = ['aluminum-pergolas', 'pool-enclosure', 'louvered-roof-system', 'patio-screens'];
const galleryP = loc<string>(area, 'galleryParagraph', lang) || area?.galleryParagraph;
const seo = (lang === 'es' && area?.seoEs) || area?.seo || {};
const processLoc = loc<any>(area, 'process', lang) || area?.process || {};

const servicesH2 = lang === 'es' ? 'Instalación de Estructuras de Exterior' : 'Outdoor Living Structures Installation';

// County + nearby cities (same county) for internal linking — unique per city, so not a doorway pattern.
const county = COUNTY_BY_SLUG[slug];
const allAreas: { slug: string; title: string; titleEs?: string }[] = await getServiceAreas();
const neighbors = allAreas
  .filter((a) => a.slug !== slug && COUNTY_BY_SLUG[a.slug] === county)
  .slice(0, 3);
const countyLabel = county || 'South Florida';

// Region-true price range from the estimator engine (a typical pergola), reused as GEO answer text.
const typical = estimateBreakdown({
  structure: 'pergola',
  sqft: 200,
  attachment: 'attached',
  roofType: 'solid-insulated',
  material: 'white',
  addOns: [],
});
const rangeText = `${formatUSD(typical.total.low)}–${formatUSD(typical.total.high)}`;
const fromSqft = DEFAULT_PRICING.structures.pergola.basePerSqft;

// Per-county permitting + wind-load facts. Miami-Dade and Broward are Florida's only two
// High-Velocity Hurricane Zones; Palm Beach is a wind-borne debris region at roughly 140–170 mph.
// The FAQ below has always split on this, but the GEO answer and the wind chip were hard-coded to
// "Miami-Dade HVHZ / 175 mph", so all 15 Palm Beach pages asserted a code that does not apply to
// them — in both languages. Everything county-dependent now reads from this one table.
// ponytail: derived from COUNTY_BY_SLUG, no new CMS field. Add `faqs` to the schema if these
// ever need to be hand-written per city like the localService pages.
const PERMIT_BY_COUNTY = {
  'Miami-Dade': {
    authority: { en: 'Miami-Dade County RER (or your city building department)', es: 'el RER del Condado de Miami-Dade (o el departamento de construcción de tu ciudad)' },
    code: { en: 'the Miami-Dade HVHZ wind-load code, rated to 175 mph, using Miami-Dade NOA-approved products', es: 'el código de cargas de viento HVHZ de Miami-Dade, hasta 175 mph, con productos aprobados por NOA de Miami-Dade' },
    codeShort: { en: 'the Miami-Dade HVHZ wind-load code', es: 'el código de cargas de viento HVHZ de Miami-Dade' },
  },
  Broward: {
    authority: { en: 'your city building department under the Broward County Board of Rules and Appeals', es: 'el departamento de construcción de tu ciudad, bajo la Junta de Reglas y Apelaciones del Condado de Broward' },
    code: { en: 'the Broward HVHZ wind-load code, rated to 175 mph', es: 'el código de cargas de viento HVHZ de Broward, hasta 175 mph' },
    codeShort: { en: 'the Broward HVHZ wind-load code', es: 'el código de cargas de viento HVHZ de Broward' },
  },
  'Palm Beach': {
    authority: { en: 'Palm Beach County PZB (or your city building department)', es: 'el PZB del Condado de Palm Beach (o el departamento de construcción de tu ciudad)' },
    code: { en: "Palm Beach County's wind-borne debris requirements, typically 140–170 mph depending on how far inland you are", es: 'los requisitos contra escombros por viento del Condado de Palm Beach, normalmente 140–170 mph según la distancia a la costa' },
    codeShort: { en: "Palm Beach County's wind-borne debris requirements", es: 'los requisitos contra escombros por viento del Condado de Palm Beach' },
  },
} as const;
const permit = PERMIT_BY_COUNTY[county] ?? PERMIT_BY_COUNTY['Miami-Dade'];
const wind = WIND_BY_COUNTY[county] ?? WIND_BY_COUNTY['Miami-Dade'];

// City-named GEO answer — distinct per page (city + county vary), alongside the unique CMS prose.
const answerQ =
  lang === 'es'
    ? `¿Instalan pérgolas y cerramientos de aluminio en ${cityName}?`
    : `Do you install aluminum pergolas and enclosures in ${cityName}?`;
const answerA =
  lang === 'es'
    ? `Sí — AB Aluminum & Screens diseña, tramita permisos e instala pérgolas de aluminio, cerramientos de piscina, porches y techos de lamas en ${cityName} y en todo ${countyLabel}. Los proyectos cuestan normalmente ${rangeText}, calculados según ${permit.codeShort.es}, con un diseño 3D gratis antes de decidir.`
    : `Yes — AB Aluminum & Screens designs, permits and installs aluminum pergolas, pool enclosures, screen rooms and louvered roofs in ${cityName} and across ${countyLabel}. Projects typically run ${rangeText}, engineered to ${permit.codeShort.en}, with a free 3D design before you commit.`;
const answerChips = [
  { icon: 'ruler', value: `from $${fromSqft}/sq ft`, label: lang === 'es' ? 'instalado' : 'installed' },
  { icon: 'wind', value: wind.value, label: wind.label[lang] },
  { icon: 'box', value: lang === 'es' ? 'Gratis' : 'Free', label: lang === 'es' ? 'diseño 3D' : '3D design' },
  { icon: 'award', value: lang === 'es' ? '15+ años' : '15+ yrs', label: lang === 'es' ? 'de experiencia' : 'in business' },
];

// Service schema — references the business by @id (declared once in BaseLayout), area = this city.
const areaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Outdoor living structure installation in ${cityName}`,
  serviceType: 'Aluminum pergola, pool enclosure, screen room & louvered roof installation',
  areaServed: { '@type': 'City', name: cityName },
  provider: { '@id': BUSINESS_ID },
  url: `${SITE_ORIGIN}${localizedHref('/service-areas/' + slug, lang)}`,
};

const nearbyH2 = lang === 'es' ? 'Áreas Cercanas que Atendemos' : 'Nearby Areas We Serve';

// City FAQ — same PERMIT_BY_COUNTY facts declared above the GEO answer.
const areaFaqs =
  lang === 'es'
    ? [
        {
          q: `¿Necesito permiso para una pérgola o un cerramiento en ${cityName}?`,
          a: `Sí. Toda estructura de aluminio anclada en ${cityName} requiere permiso de construcción, tramitado ante ${permit.authority.es}. Nosotros preparamos los planos sellados, presentamos la solicitud y acompañamos las inspecciones — no tienes que gestionar nada.`,
        },
        {
          q: `¿A qué resistencia de viento se calculan las estructuras en ${cityName}?`,
          a: `Diseñamos según ${permit.code.es}. La ingeniería se sella antes de presentar el permiso, así que la estructura pasa la inspección y queda documentada para tus registros.`,
        },
        {
          q: `¿Cuánto cuesta un proyecto en ${cityName}?`,
          a: `Una pérgola adosada típica de 200 sq ft en ${countyLabel} cuesta ${rangeText} instalada, desde $${fromSqft} por sq ft. El precio final depende del tamaño, el tipo de techo y los extras. El diseño 3D es gratis y sin compromiso.`,
        },
      ]
    : [
        {
          q: `Do I need a permit for a pergola or enclosure in ${cityName}?`,
          a: `Yes. Any anchored aluminum structure in ${cityName} requires a building permit, pulled through ${permit.authority.en}. We prepare the sealed drawings, file the application and meet the inspector — you don't handle any of it.`,
        },
        {
          q: `What wind rating do structures in ${cityName} have to meet?`,
          a: `We engineer to ${permit.code.en}. The engineering is sealed before the permit is filed, so the structure passes inspection and is documented for your records.`,
        },
        {
          q: `How much does a project in ${cityName} cost?`,
          a: `A typical 200 sq ft attached pergola in ${countyLabel} runs ${rangeText} installed, from $${fromSqft} per sq ft. Final pricing depends on size, roof type and add-ons. The 3D design is free and carries no obligation.`,
        },
      ];
---

<BaseLayout
  lang={lang}
  title={seo.metaTitle || `${titlePage} | AB Aluminum & Screens`}
  description={seo.metaDescription || loc<string>(area, 'descriptionPage', lang) || area?.descriptionPage}
  jsonLd={areaJsonLd}
>
  <Breadcrumbs
    lang={lang}
    items={[{ label: t('nav.serviceAreas'), href: localizedHref('/service-areas', lang) }, { label: cityName }]}
  />

  <PageHero
    lang={lang}
    align="center"
    badges={true}
    title={titlePage}
    subtitle={p1}
    image="/images/service-area-hero-south-florida-pergola-pool.webp"
    ctas={[{ label: t('cta.requestEstimate'), href: localizedHref('/contact-us', lang) }]}
  />

  <!-- GEO direct-answer (city-named, real pricing) -->
  <AnswerBlock
    lang={lang}
    question={answerQ}
    answer={answerA}
    chips={answerChips}
    alt={true}
    image="/images/aluminum-pergola-louvers-patio-pool-tropical-plants-florida.avif"
    imageAlt={lang === 'es'
      ? `Pérgola de lamas de aluminio junto a una piscina con plantas tropicales en ${cityName}, sur de Florida`
      : `Aluminum louvered pergola beside a pool with tropical plants in ${cityName}, South Florida`}
  />

  <FAQ lang={lang} items={areaFaqs} />

  <!-- City-specific intro + the services we install here (elevated for local SEO) -->
  <section class="section">
    <div class="container">
      <h2 class="area-head text-center">{heading || servicesH2}</h2>
      {p2 && <p class="lead area-intro">{p2}</p>}
      <div class="grid cols-4" style="margin-top:2rem;">
        {
          SERVICES.map((s) => (
            <a
              class="card area-svc"
              href={localizedHref(localRoutes.has(s.route) ? '/' + s.route + '/' + slug : '/' + s.route, lang)}
            >
              <img src={s.thumb} alt={s.label[lang]} width="320" height="200" loading="lazy" />
              <div class="area-svc__body">
                <h3>{s.label[lang]} {localRoutes.has(s.route) ? (lang === 'es' ? 'en ' + cityName : 'in ' + cityName) : ''}</h3>
                <p>{services[CMS_SERVICE_ORDER.indexOf(s.route)]?.paragraph || s.blurb[lang]}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <AboutIntro lang={lang} alt={true} />

  <GalleryMosaic lang={lang} sub={galleryP || undefined} />
  <Reviews lang={lang} limit={3} sub={loc<string>(area, 'reviewsParagraph', lang) || undefined} />
  <FinancingTeaser lang={lang} alt={true} />
  <ProcessSteps lang={lang} intro={processLoc?.intro} />

  {
    neighbors.length > 0 && (
      <section class="section">
        <div class="container narrow text-center">
          <h2>{nearbyH2}</h2>
          <ul class="nearby" data-reveal>
            {neighbors.map((n) => (
              <li>
                <a href={localizedHref('/service-areas/' + n.slug, lang)}>
                  {(lang === 'es' && n.titleEs) || n.title}
                </a>
              </li>
            ))}
            <li>
              <a class="nearby__all" href={localizedHref('/service-areas', lang)}>
                {lang === 'es' ? 'Todas las áreas →' : 'All service areas →'}
              </a>
            </li>
          </ul>
        </div>
      </section>
    )
  }

  <LeadSection lang={lang} source={`area:${slug}`} alt={false} />
</BaseLayout>

<style>
  /* Heading: constrain the measure so long city names wrap into 2–3 even lines
     instead of stretching the full container and orphaning a lone word. */
  .area-head {
    max-width: 34rem;
    margin-inline: auto;
    text-wrap: balance;
  }
  /* Intro: centered column + centered text; pretty evens the ragged edges and
     avoids orphan last-line words across the ~135–515 char range of city intros. */
  .area-intro {
    max-width: 62ch;
    margin: 1.25rem auto 0;
    text-align: center;
    text-wrap: pretty;
  }
  .area-svc {
    display: flex;
    flex-direction: column;
  }
  .area-svc img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .area-svc__body {
    padding: 1rem 1.25rem;
  }
  .area-svc__body p {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 0.5rem;
  }
  .nearby {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .nearby a {
    display: inline-block;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: var(--light-gray);
    border: 1px solid var(--border);
    font-weight: 600;
    font-size: 0.875rem;
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .nearby a:hover {
    border-color: var(--red);
    color: var(--red);
  }
  .nearby__all {
    background: #fff !important;
    color: var(--red-ink);
  }
</style>
